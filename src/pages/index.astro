---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import TavernCard from '../components/TavernCard';
import NpcCard from '../components/NpcCard';
import LootCard from '../components/LootCard';
---

<Layout>
  <Header />

  <!-- Grid de Cards Idêntico ao Mockup -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <TavernCard client:load />
    <NpcCard client:load />
    <LootCard client:load />
  </div>

  <footer class="mt-14 text-center text-xs text-slate-500 border-t border-[#1a1f38] pt-6 font-mono">
    O Oráculo &bull; beyond-obvious.net &bull; Pronto para expansões arcanas
  </footer>
</Layout>