---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Navbar from '../components/Navbar.astro';

// Cards Essenciais Padrão da Mesa
import TavernCard from '../components/TavernCard';
import NpcCard from '../components/NpcCard';
import VignetteCard from '../components/VignetteCard';
import LootCard from '../components/LootCard';

// Cards Complementares Disponíveis para Afixar
import SpellCard from '../components/SpellCard';
import BookCard from '../components/BookCard';
import MushroomCard from '../components/MushroomCard';
import NobleHouseCard from '../components/NobleHouseCard';
import MercenaryCard from '../components/MercenaryCard';
import AssassinGuildCard from '../components/AssassinGuildCard';
import PirateCrewCard from '../components/PirateCrewCard';
import OutlawBandCard from '../components/OutlawBandCard';
import GoblinGangCard from '../components/GoblinGangCard';
import CultCard from '../components/CultCard';
import DruidCircleCard from '../components/DruidCircleCard';
import MerchantGuildCard from '../components/MerchantGuildCard';
import CraftingGuildCard from '../components/CraftingGuildCard';
import MilitaryCompanyCard from '../components/MilitaryCompanyCard';
import TroupeCard from '../components/TroupeCard';

import SessionLog from '../components/SessionLog';
---

<Layout>
  <Header />
  <Navbar />

  <!-- Faixa de Boas-vindas / Estado da Mesa -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[#1c2242]">
    <div>
      <h2 class="text-base font-bold text-slate-100 font-['Cinzel'] tracking-wide">
        Mesa Principal da Sessão
      </h2>
      <p class="text-xs text-slate-400">
        Cards essenciais e geradores afixados para consulta imediata na rodada.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <a
        href="/faccoes"
        class="text-xs text-oracle-gold hover:text-oracle-gold-light border border-[#2b3360] hover:border-oracle-gold/40 px-2.5 py-1.5 rounded-lg bg-[#0e1224] transition-all font-mono flex items-center gap-1"
      >
        <span>🏛️</span> Explorar Todas as Facções →
      </a>
    </div>
  </div>

  <!-- Grid Principal (Cards Padrão + Espaço para Afixados) -->
  <div id="deck-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Essenciais Básicos -->
    <div class="deck-card" data-card-id="taverna">
      <TavernCard client:load />
    </div>
    <div class="deck-card" data-card-id="npc">
      <NpcCard client:load />
    </div>
    <div class="deck-card" data-card-id="cenas">
      <VignetteCard client:load />
    </div>
    <div class="deck-card" data-card-id="tesouro">
      <LootCard client:load />
    </div>

    <!-- Cards Adicionais (Controlados dinamicamente via Pins) -->
    <div class="deck-card hidden" data-card-id="grimorio">
      <SpellCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="tomos">
      <BookCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="alquimia-cogumelos">
      <MushroomCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="nobres">
      <NobleHouseCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="mercenarios">
      <MercenaryCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="assassinos">
      <AssassinGuildCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="piratas">
      <PirateCrewCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="foras-da-lei">
      <OutlawBandCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="goblins">
      <GoblinGangCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="cultos">
      <CultCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="druidas">
      <DruidCircleCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="mercadores">
      <MerchantGuildCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="artesaos">
      <CraftingGuildCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="militares">
      <MilitaryCompanyCard client:load />
    </div>
    <div class="deck-card hidden" data-card-id="trupes">
      <TroupeCard client:load />
    </div>
  </div>

  <SessionLog client:load />

  <footer class="mt-14 text-center text-xs text-slate-500 border-t border-[#1a1f38] pt-6 font-mono">
    O Oráculo &bull; beyond-obvious.net &bull; Respostas imediatas para o destino da mesa
  </footer>
</Layout>

<script>
  import { getPinnedCards } from '../utils/pins';

  function applyPins() {
    const pinned = getPinnedCards();
    const cards = document.querySelectorAll<HTMLDivElement>('.deck-card');

    cards.forEach((card) => {
      const id = card.dataset.cardId;
      if (id && pinned.includes(id)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  // Executa na carga e escuta atualizações de pins
  applyPins();
  window.addEventListener('oracle:pins-updated', applyPins);
  document.addEventListener('astro:page-load', applyPins);
</script>