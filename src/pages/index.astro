---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import TavernCard from '../components/TavernCard';
import NpcCard from '../components/NpcCard';
import LootCard from '../components/LootCard';
import BookCard from '../components/BookCard';
import MushroomCard from '../components/MushroomCard';
import SpellCard from '../components/SpellCard';
import VignetteCard from '../components/VignetteCard';
import TroupeCard from '../components/TroupeCard';
import AssassinGuildCard from '../components/AssassinGuildCard';
import CraftingGuildCard from '../components/CraftingGuildCard';
import CultCard from '../components/CultCard';
import DruidCircleCard from '../components/DruidCircleCard';
import GoblinGangCard from '../components/GoblinGangCard';
import MercenaryCard from '../components/MercenaryCard';
import MerchantGuildCard from '../components/MerchantGuildCard';
import MilitaryCompanyCard from '../components/MilitaryCompanyCard';
import NobleHouseCard from '../components/NobleHouseCard';
import OutlawBandCard from '../components/OutlawBandCard';
import PirateCrewCard from '../components/PirateCrewCard';
import UpcomingModules from '../components/UpcomingModules.astro';
import SessionLog from '../components/SessionLog';
---

<Layout>
  <Header />

  <!-- Barra de Filtros por Categoria com Ação Dinâmica -->
  <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6 border-b border-[#1c2242] no-scrollbar text-xs">
    <button 
      data-filter="all" 
      class="filter-btn active px-3.5 py-1.5 rounded-md bg-[#161d3b] text-oracle-gold border border-oracle-gold/40 font-semibold uppercase tracking-wider font-['Cinzel'] transition-all"
    >
      ✦ Todos
    </button>
    <button 
      data-filter="cidades" 
      class="filter-btn px-3.5 py-1.5 rounded-md bg-[#0e1224] text-slate-400 hover:text-slate-200 border border-[#22294c] transition-all uppercase tracking-wider font-['Cinzel']"
    >
      ⚔ Sessão & Cidades
    </button>
    <button 
      data-filter="faccoes" 
      class="filter-btn px-3.5 py-1.5 rounded-md bg-[#0e1224] text-slate-400 hover:text-slate-200 border border-[#22294c] transition-all uppercase tracking-wider font-['Cinzel']"
    >
      🏛️ Facções & Grupos
    </button>
    <button 
      data-filter="arcano" 
      class="filter-btn px-3.5 py-1.5 rounded-md bg-[#0e1224] text-slate-400 hover:text-slate-200 border border-[#22294c] transition-all uppercase tracking-wider font-['Cinzel']"
    >
      ✨ Arcano & Magia
    </button>
    <button 
      data-filter="alquimia" 
      class="filter-btn px-3.5 py-1.5 rounded-md bg-[#0e1224] text-slate-400 hover:text-slate-200 border border-[#22294c] transition-all uppercase tracking-wider font-['Cinzel']"
    >
      🍄 Alquimia & Ermos
    </button>
    <button 
      data-filter="tesouros" 
      class="filter-btn px-3.5 py-1.5 rounded-md bg-[#0e1224] text-slate-400 hover:text-slate-200 border border-[#22294c] transition-all uppercase tracking-wider font-['Cinzel']"
    >
      📜 Tesouros & Tomos
    </button>
  </div>

  <!-- Grid com os Geradores -->
  <div id="generator-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="card-item" data-category="cidades">
      <TavernCard client:load />
    </div>
    <div class="card-item" data-category="cidades">
      <NpcCard client:load />
    </div>
    <div class="card-item" data-category="cidades">
      <VignetteCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <PirateCrewCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <OutlawBandCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <NobleHouseCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <MilitaryCompanyCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <MerchantGuildCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <MercenaryCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <GoblinGangCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <DruidCircleCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <CultCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <CraftingGuildCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <AssassinGuildCard client:load />
    </div>
    <div class="card-item" data-category="faccoes">
      <TroupeCard client:load />
    </div>
    <div class="card-item" data-category="tesouros">
      <LootCard client:load />
    </div>
    <div class="card-item" data-category="arcano">
      <SpellCard client:load />
    </div>
    <div class="card-item" data-category="tesouros">
      <BookCard client:load />
    </div>
    <div class="card-item" data-category="alquimia">
      <MushroomCard client:load />
    </div>
  </div>

  <UpcomingModules />
  <SessionLog client:load />

  <footer class="mt-14 text-center text-xs text-slate-500 border-t border-[#1a1f38] pt-6 font-mono">
    O Oráculo &bull; beyond-obvious.net &bull; Respostas imediatas para o destino da mesa
  </footer>
</Layout>

<script>
  function setupFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLDivElement>('.card-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;

        buttons.forEach((b) => {
          b.classList.remove('active', 'bg-[#161d3b]', 'text-oracle-gold', 'border-oracle-gold/40', 'font-semibold');
          b.classList.add('bg-[#0e1224]', 'text-slate-400', 'border-[#22294c]');
        });

        btn.classList.add('active', 'bg-[#161d3b]', 'text-oracle-gold', 'border-oracle-gold/40', 'font-semibold');
        btn.classList.remove('bg-[#0e1224]', 'text-slate-400', 'border-[#22294c]');

        cards.forEach((card) => {
          const category = card.dataset.category;
          if (filter === 'all' || category === filter) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>