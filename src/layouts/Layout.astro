---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "O Oráculo", 
  description = "Grimório de Ferramentas Rápidas & Tabelas Aleatórias para Mestres de RPG" 
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — {description}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Cinzel+Decorative:wght@700&family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-oracle-bg text-slate-200 min-h-screen selection:bg-amber-500/30 selection:text-amber-200 font-['Inter'] antialiased">
    <!-- Grade sutil de fundo místico -->
    <div class="fixed inset-0 pointer-events-none opacity-20 bg-[radial-gradient(circle_at_50%_0%,rgba(99,102,241,0.35),transparent_60%)]"></div>
    <div class="fixed inset-0 pointer-events-none opacity-5 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-size-[24px_24px]"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-4">
      <slot />
    </div>
  </body>
</html>