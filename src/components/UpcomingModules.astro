---
---
<section class="mt-14">
  <div class="mb-4">
    <h2 class="text-lg font-bold text-oracle-gold-light font-['Cinzel'] flex items-center gap-2">
      <span class="text-oracle-gold">🔮</span> PRÓXIMOS MÓDULOS & TABELAS EXPANSÍVEIS
    </h2>
    <p class="text-xs text-indigo-300/80 font-sans mt-0.5">
      Prontos para receber suas tabelas em texto solto ou JSON no subdomínio
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <!-- Boatos & Fofocas -->
    <div class="bg-[#0b0e20]/60 border border-dashed border-[#2b3562] rounded-xl p-5 flex flex-col justify-between hover:border-[#404e8d] transition-colors">
      <div>
        <div class="text-xl mb-2">📜</div>
        <h3 class="text-sm font-bold text-slate-200 font-['Cinzel'] tracking-wider uppercase mb-1">
          Boatos & Fofocas
        </h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-6">
          Conversas ouvidas nas esquinas, meias-verdades e mistérios da região.
        </p>
      </div>
      <button class="w-full py-2 px-3 rounded-md bg-transparent hover:bg-[#151a38] border border-[#2e3766] text-oracle-gold text-xs font-['Cinzel'] tracking-wide transition-colors">
        Pré-visualizar Rascunho
      </button>
    </div>

    <!-- Encontros nos Ermos -->
    <div class="bg-[#0b0e20]/60 border border-dashed border-[#2b3562] rounded-xl p-5 flex flex-col justify-between hover:border-[#404e8d] transition-colors">
      <div>
        <div class="text-xl mb-2">🐺</div>
        <h3 class="text-sm font-bold text-slate-200 font-['Cinzel'] tracking-wider uppercase mb-1">
          Encontros nos Ermos
        </h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-6">
          Emboscadas, caravanas mercantes perdidas ou ruínas escondidas na mata.
        </p>
      </div>
      <button class="w-full py-2 px-3 rounded-md bg-transparent hover:bg-[#151a38] border border-[#2e3766] text-oracle-gold text-xs font-['Cinzel'] tracking-wide transition-colors">
        Pré-visualizar Rascunho
      </button>
    </div>

    <!-- Armadilhas & Perigos -->
    <div class="bg-[#0b0e20]/60 border border-dashed border-[#2b3562] rounded-xl p-5 flex flex-col justify-between hover:border-[#404e8d] transition-colors">
      <div>
        <div class="text-xl mb-2">⚙️</div>
        <h3 class="text-sm font-bold text-slate-200 font-['Cinzel'] tracking-wider uppercase mb-1">
          Armadilhas & Perigos
        </h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-6">
          Gatilhos mecânicos, dardos envenenados, placas de pressão e runas falsas.
        </p>
      </div>
      <button class="w-full py-2 px-3 rounded-md bg-transparent hover:bg-[#151a38] border border-[#2e3766] text-oracle-gold text-xs font-['Cinzel'] tracking-wide transition-colors">
        Pré-visualizar Rascunho
      </button>
    </div>

    <!-- Clima & Condições -->
    <div class="bg-[#0b0e20]/60 border border-dashed border-[#2b3562] rounded-xl p-5 flex flex-col justify-between hover:border-[#404e8d] transition-colors">
      <div>
        <div class="text-xl mb-2">🌧️</div>
        <h3 class="text-sm font-bold text-slate-200 font-['Cinzel'] tracking-wider uppercase mb-1">
          Clima & Condições
        </h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-6">
          Nevoeiro denso, ventania congelante ou chuva ácida afetando a visibilidade.
        </p>
      </div>
      <button class="w-full py-2 px-3 rounded-md bg-transparent hover:bg-[#151a38] border border-[#2e3766] text-oracle-gold text-xs font-['Cinzel'] tracking-wide transition-colors">
        Pré-visualizar Rascunho
      </button>
    </div>
  </div>
</section>