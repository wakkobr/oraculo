---
---
<!-- Top Navbar -->
<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 mb-8 border-b border-[#1e243d]">
  <div class="flex items-center gap-3.5">
    <!-- Brasão / Símbolo Arcano -->
    <div class="w-11 h-11 rounded-lg bg-[#0e1222] border border-[#d4af37]/40 flex items-center justify-center shadow-[0_0_15px_-3px_rgba(212,175,55,0.2)]">
      <svg class="w-6 h-6 text-[#d4af37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
    </div>

    <div>
      <h1 class="text-2xl font-bold tracking-wider text-[#f3e5ab] font-['Cinzel']">
        O Oráculo
      </h1>
      <p class="text-xs text-slate-400 font-light tracking-wide mt-0.5">
        Respostas imediatas para o destino da mesa
      </p>
    </div>
  </div>

  <!-- Barra de Busca de Geradores -->
  <div class="relative w-full md:w-80">
    <input 
      type="text" 
      placeholder="Filtrar geradores (ex: taverna, npc)..." 
      class="w-full px-3.5 py-2 pl-9 bg-[#0b0e1d] border border-[#232948] rounded-md text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-[#d4af37]/50 transition-colors"
    />
    <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2"></line>
    </svg>
  </div>
</header>

<!-- Cabeçalho de Seção -->
<div class="flex items-center justify-between mb-5">
  <h2 class="text-lg font-bold text-[#f3e5ab] font-['Cinzel'] flex items-center gap-2">
    <span class="text-[#d4af37]">⚔</span> GERADORES DE AÇÃO IMEDIATA
  </h2>
  <span class="text-xs text-slate-500">Clique em 'Rolar' ou no botão circular para regerar</span>
</div>