---
import OracleLogo from './OracleLogo.astro';
---

<!-- Top Navbar -->
<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 mb-8 border-b border-[#1e243d]">
  <div class="flex items-center gap-4">
    <!-- Novo Logo Arcano do Oráculo -->
    <OracleLogo class="w-13 h-13" />

    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl md:text-3xl font-extrabold tracking-wider text-transparent bg-clip-text bg-linear-to-r from-[#faecc5] via-oracle-gold to-[#e2c974] font-['Cinzel'] drop-shadow-[0_2px_10px_rgba(212,175,55,0.25)]">
          O ORÁCULO
        </h1>
      </div>
      <p class="text-xs text-slate-400 font-light tracking-wide mt-0.5">
        Respostas imediatas para o destino da mesa
      </p>
    </div>
  </div>

  <!-- Barra de Busca de Geradores -->
  <div class="relative w-full md:w-80">
    <input 
      type="text" 
      placeholder="Filtrar geradores (ex: taverna, npc, livro)..." 
      class="w-full px-3.5 py-2 pl-9 bg-[#0b0e1d] border border-[#232948] rounded-md text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-oracle-gold/50 transition-colors"
    />
    <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2"></line>
    </svg>
  </div>
</header>

<!-- Cabeçalho de Seção -->
<div class="flex items-center justify-between mb-5">
  <h2 class="text-lg font-bold text-oracle-gold-light font-['Cinzel'] flex items-center gap-2">
    <span class="text-oracle-gold">⚔</span> GERADORES DE AÇÃO IMEDIATA
  </h2>
  <span class="text-xs text-slate-500">Clique em 'Rolar' ou no botão circular para regerar</span>
</div>